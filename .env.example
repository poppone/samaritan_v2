# Copia questo file in `.env` e riempi i valori.
# Il file `.env` e' ignorato da git: non finira' mai su GitHub.

# --- OBBLIGATORIE ---
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
# Opzionale: modelli Groq da provare in ordine, separati da virgola.
# Default: openai/gpt-oss-120b,openai/gpt-oss-20b
# Elenco aggiornato: https://console.groq.com/docs/models
# GROQ_MODELLI=openai/gpt-oss-120b,openai/gpt-oss-20b
PEXELS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# Voce realistica a pagamento. Se manca, si usa la voce Microsoft gratuita.
ELEVENLABS_API_KEY=
# Nome della voce come appare su elevenlabs.io, oppure il suo id.
# Vuoto = la prima voce dell'account.
# Piu' nomi separati da virgola vengono alternati, un video a testa.
ELEVENLABS_VOCE=

# --- Identita canale ---
# Vincono su canale.json. Vuote = si usano quelle di canale.json, oppure
# Poppone TV / @PopponeTV se il file non c'e'. Vedi canale.esempio.json.
NOME_CANALE=
HANDLE_CANALE=

# --- Voce neurale (Edge-TTS, gratuita) ---
# it-IT-DiegoNeural | it-IT-IsabellaNeural | it-IT-GiuseppeNeural
VOCE_TTS=it-IT-DiegoNeural
VOCE_VELOCITA=+12%
VOCE_PITCH=+8Hz

# --- Rendering ---
FPS=30
NUM_CLIP_SFONDO=4
WHISPER_MODEL=base

# --- Formato del video ---
# Vuoto o 0 = Short verticale 9:16 da mezzo minuto (com'e' sempre stato).
# 1 = video lungo 16:9 da otto minuti, diviso in sezioni con i capitoli.
# Le misure (risoluzione, ritmo degli stacchi, secondi di trailer, clip di
# casa, preset di rendering) cambiano da sole: vedi config.applica_formato.
VIDEO_LUNGO=
MINUTI_VIDEO_LUNGO=8
SEZIONI_VIDEO_LUNGO=6

# --- Pubblicazione ---
# public  = pubblica subito (massima velocita)
# private = carica ma NON pubblica, aspetta la tua approvazione
PRIVACY_STATUS=public

# --- Notifiche Telegram (opzionali ma consigliate) ---
# Crea un bot con @BotFather, poi ricava il tuo chat id con @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Instagram: i Reel che vendono Samaritan (opzionali) ---
# Profilo SEPARATO da quello di gaming, e deve essere professionale.
# Come si ricavano queste due: vedi GUIDA_INSTAGRAM.md
# Se mancano, promo.py monta il Reel su disco e non pubblica niente.
INSTAGRAM_TOKEN=
INSTAGRAM_USER_ID=
# Come chiude la didascalia di ogni Reel.
CONTATTO_PROMO=scrivimi in DM

# --- Clip dalle live Twitch (taglia_live/, gira sul PC) ---
# Token GitHub "fine-grained" limitato al solo repository samaritan_v2, con
# permesso Contents: Read and write. Serve a caricare le clip sulla Release e
# a scrivere le schede in clip_live/da_pubblicare/. Vedi taglia_live/README.md.
GITHUB_TOKEN_CLIP=
TWITCH_CANALE=davidedurazzi
CLIP_PER_LIVE=5
# small sta in meno di 8 GB di GPU; con la sola CPU e' piu' lento ma va.
WHISPER_MODELLO_CLIP=small
# cpu = salta la GPU. Vuoto = prova la GPU e, se mancano le librerie CUDA,
# passa da solo alla CPU.
WHISPER_DISPOSITIVO=
# Percorso di TwitchDownloaderCLI.exe (facoltativo: senza, conta solo l'audio)
TWITCHDOWNLOADER=
