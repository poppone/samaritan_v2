# Copia questo file in `.env` e riempi i valori.
# Il file `.env` e' ignorato da git: non finira' mai su GitHub.

# --- OBBLIGATORIE ---
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
PEXELS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Identita canale ---
NOME_CANALE=Poppone TV

# --- Voce neurale (Edge-TTS, gratuita) ---
# it-IT-DiegoNeural | it-IT-IsabellaNeural | it-IT-GiuseppeNeural
VOCE_TTS=it-IT-DiegoNeural
VOCE_VELOCITA=+12%
VOCE_PITCH=+8Hz

# --- Rendering ---
FPS=30
NUM_CLIP_SFONDO=4
WHISPER_MODEL=base

# --- Pubblicazione ---
# public  = pubblica subito (massima velocita)
# private = carica ma NON pubblica, aspetta la tua approvazione
PRIVACY_STATUS=public

# --- Notifiche Telegram (opzionali ma consigliate) ---
# Crea un bot con @BotFather, poi ricava il tuo chat id con @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
